# Local development uses SQLite automatically. Set this for PostgreSQL:
# DATABASE_URL=postgresql+psycopg://dhara:change-me@localhost:5432/dhara
DATABASE_URL=sqlite:///./data/dhara.db
UPLOAD_DIR=./data/uploads
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
TOKEN_SECRET=replace-with-a-long-random-secret
FILE_ENCRYPTION_KEY=replace-with-a-separate-long-random-secret
AUDIT_SIGNING_KEY=replace-with-a-separate-audit-signing-secret
TOKEN_MINUTES=480
DEMO_PASSWORD=change-this-before-deployment

# Optional government-system connectors. Their configuration status appears in
# the administrator console; credentials should be injected by a secret manager.
LRMS_BASE_URL=
LRMS_API_TOKEN=
DILRMP_BASE_URL=
DILRMP_API_TOKEN=
GEOSERVER_URL=
GEOSERVER_API_TOKEN=
REGISTRATION_API_URL=
REGISTRATION_API_TOKEN=
NOTIFICATION_GATEWAY_URL=
NOTIFICATION_GATEWAY_TOKEN=
MALWARE_SCAN_URL=
MALWARE_SCAN_TOKEN=

# OpenID Connect / government SSO. The callback defaults to
# https://<site>/api/auth/oidc/callback in the hosted runtime.
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=
