{
  "name": "dhara-land-records",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vite",
    "dev:api": ".venv/bin/python -m uvicorn backend.app:app --reload --port 8000",
    "dev:all": "concurrently -k \"npm:dev:api\" \"npm:dev\"",
    "build": "tsc -b && vite build",
    "build:site": "tsc -b && SITES_BUILD=1 vite build",
    "preview:site": "SITES_BUILD=1 vite preview",
    "preview": "vite preview",
    "test:ui": "node tests/ui-smoke.mjs",
    "test:ocr-ui": "node tests/ocr-ui-smoke.mjs"
  },
  "dependencies": {
    "@vitejs/plugin-react": "latest",
    "jose": "^6.1.0",
    "lucide-react": "latest",
    "pdfjs-dist": "^5.4.149",
    "powerbi-client": "^2.24.1",
    "powerbi-client-react": "^2.0.2",
    "react": "latest",
    "react-dom": "latest",
    "tesseract.js": "^6.0.1",
    "vite": "latest"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@cloudflare/workers-types": "4.20260515.1",
    "@openai/sites-vite-plugin": "0.2.0",
    "@types/node": "^22.20.2",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "concurrently": "latest",
    "puppeteer-core": "latest",
    "typescript": "latest",
    "wrangler": "4.92.0"
  }
}
